# NetWatch configuration. setup.sh copies this to .env on first run; edit .env, then
# re-run setup.sh (or `docker compose up -d`) to apply.

TZ=America/Toronto

# Port the web UI and API listen on (host networking, so this is the host port).
NETWATCH_PORT=8085

# Address to bind. With host networking, 0.0.0.0 listens on every host interface.
# To restrict to the LAN only, set this to the TrueNAS LAN IP, e.g. 192.168.2.15.
NETWATCH_BIND=0.0.0.0

# Retention: raw per-probe samples, and 1-minute rollups used for long-range graphs.
NETWATCH_RAW_RETENTION_DAYS=7
NETWATCH_ROLLUP_RETENTION_DAYS=90

# Logging: json (structured) or text.
NETWATCH_LOG_LEVEL=INFO
NETWATCH_LOG_FORMAT=json

# Expose Prometheus metrics at /metrics.
NETWATCH_METRICS_ENABLED=false
