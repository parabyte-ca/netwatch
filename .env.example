# NetWatch configuration. setup.sh copies this to .env on first run; edit .env, then
# re-run setup.sh (or `docker compose up -d`) to apply.

TZ=America/Toronto

# Port the web UI and API listen on (host networking, so this is the host port).
NETWATCH_PORT=8090

# Address to bind. With host networking, 0.0.0.0 listens on every host interface.
# To restrict to the LAN only, set this to the TrueNAS LAN IP, e.g. 192.168.2.15.
NETWATCH_BIND=0.0.0.0

# Retention: raw per-probe samples, and 1-minute rollups used for long-range graphs.
NETWATCH_RAW_RETENTION_DAYS=7
NETWATCH_ROLLUP_RETENTION_DAYS=90

# Logging: json (structured) or text.
NETWATCH_LOG_LEVEL=INFO
NETWATCH_LOG_FORMAT=json

# Expose Prometheus metrics at /metrics.
NETWATCH_METRICS_ENABLED=false

# Bearer token Prometheus uses to scrape /metrics (all other access requires signing in).
NETWATCH_METRICS_TOKEN=

# Set true only when NetWatch is served over HTTPS (e.g. behind a TLS reverse proxy).
NETWATCH_COOKIE_SECURE=false

# Sign-in lockout: failed attempts per client within 5 minutes, and lockout length (seconds).
NETWATCH_LOGIN_MAX_FAILURES=5
NETWATCH_LOGIN_LOCKOUT_S=300

# Most settings can also be changed on the Admin page; values saved there override this file.

# Daily check of GitHub releases for in-app updates.
NETWATCH_UPDATE_CHECK=true
# Initial automatic-update policy (off | notify | patch | minor) and window; afterwards these
# are managed on the System page.
NETWATCH_AUTO_UPDATE=patch
NETWATCH_AUTO_UPDATE_WINDOW=03:30

# Outage detection: failures to declare down, successes to recover, loss % thresholds.
NETWATCH_DOWN_AFTER=3
NETWATCH_UP_AFTER=3
NETWATCH_DEGRADED_ENTER_PCT=5
NETWATCH_DEGRADED_EXIT_PCT=1

# NIC telemetry: empty = default-route interface plus its physical ports.
NETWATCH_NIC_INTERFACES=

# Path tests (mtr): schedule for public targets (minutes, 0 = off) and on outage.
NETWATCH_PATH_TEST_INTERVAL_MIN=15
NETWATCH_PATH_TEST_ON_OUTAGE=true

# Discovery. Passive listening (ARP/DHCP/mDNS/SSDP, sends nothing) and hourly active scanning
# are on by default. Active scanning can be switched off on the Devices page; this is only its
# initial state.
NETWATCH_DISCOVERY_PASSIVE=true
NETWATCH_DISCOVERY_ACTIVE=true
# Empty = default-route interface and its own subnet. Private ranges only, max /22 each.
NETWATCH_DISCOVERY_INTERFACE=
NETWATCH_DISCOVERY_SUBNETS=
NETWATCH_DISCOVERY_SCAN_INTERVAL_MIN=60
